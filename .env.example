# --- HubSpot (input half) ---
# Private app token with crm.lists.read + crm.objects.contacts.read scopes.
# Create at: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The HubSpot active list to pull from. No default on purpose, set this to
# your own list's numeric ID.
HUBSPOT_LIST_ID=

# --- Claude (ICP classification) ---
# Anthropic API key. Classifier uses claude-haiku-4-5 via the Batches API.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Browserless (outreach-tool sink) ---
# Your Browserless WebSocket endpoint + token.
# e.g. wss://production-sfo.browserless.io/chromium?token=YOUR_TOKEN
BROWSERLESS_WS=wss://production-sfo.browserless.io/chromium?token=YOUR_TOKEN

# --- Outreach tool (Dripify by default, swap for whatever you use) ---
# The campaign you want leads added to (open the campaign and copy the URL).
DRIPIFY_CAMPAIGN_URL=https://app.dripify.com/campaigns/XXXXXXXX

# Auth model: how the script authenticates WITHOUT a password.
# Path A (default): cookie injection. Export your session cookies once
# (DevTools > Application > Cookies, or a "EditThisCookie" export) into this file.
DRIPIFY_COOKIES_FILE=dripify-cookies.json
